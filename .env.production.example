# Copy to .env on the server and fill in real values. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=CHANGE_ME
DEBUG=False
ALLOWED_HOSTS=hilltop.bthinkx.com
CSRF_TRUSTED_ORIGINS=https://hilltop.bthinkx.com

# Leave DATABASE_URL unset to use SQLite (db.sqlite3 in the project folder).
# To move to PostgreSQL later: DATABASE_URL=postgres://erp_user:CHANGE_ME@localhost:5432/hilltop_erp
