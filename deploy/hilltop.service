[Unit]
Description=Hilltop ERP (gunicorn)
After=network.target

[Service]
User=www-data
WorkingDirectory=/srv/hilltop
EnvironmentFile=/srv/hilltop/.env
ExecStart=/srv/hilltop/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --access-logfile -
Restart=always

[Install]
WantedBy=multi-user.target
